{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttools.local/schemas/devlog-status.schema.json",
  "title": "Development Log Pipeline Status",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "article_ready",
    "prompt_ready",
    "image_ready",
    "published",
    "stage",
    "error",
    "validation",
    "node_runner_handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "article_ready": {
      "const": true
    },
    "prompt_ready": {
      "const": true
    },
    "image_ready": {
      "const": true
    },
    "published": {
      "type": "boolean"
    },
    "stage": {
      "enum": [
        "validated",
        "pushed",
        "publish_pending",
        "published",
        "publish_failed",
        "validation_failed"
      ]
    },
    "error": {
      "type": ["string", "null"]
    },
    "validation": {
      "type": "object",
      "required": [
        "html_well_formed",
        "local_links_valid",
        "placeholders_absent",
        "article_index_title_date_match",
        "image_dimensions_match",
        "responsive_image_css",
        "ogp_and_x_share_present",
        "git_diff_check",
        "publication_scope_exactly_four_files",
        "secret_pattern_scan"
      ],
      "properties": {
        "html_well_formed": { "const": true },
        "local_links_valid": { "const": true },
        "placeholders_absent": { "const": true },
        "article_index_title_date_match": { "const": true },
        "image_dimensions_match": { "const": true },
        "responsive_image_css": { "const": true },
        "ogp_and_x_share_present": { "const": true },
        "git_diff_check": { "const": true },
        "publication_scope_exactly_four_files": { "const": true },
        "secret_pattern_scan": { "const": true }
      },
      "additionalProperties": true
    },
    "node_runner_handoff": {
      "type": "object",
      "required": ["ready", "paths"],
      "properties": {
        "ready": { "const": true },
        "paths": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
