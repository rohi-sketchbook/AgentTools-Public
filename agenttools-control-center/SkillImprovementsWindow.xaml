<Window x:Class="AgentToolsControlCenter.SkillImprovementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill改善候補 - AgentTools Control Center"
        Width="1180" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Skill改善候補" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="候補は自動適用されません。diffを確認して承認し、承認済み候補だけを明示的に適用します。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="再読込" Click="RefreshButton_Click" />
                <Button Content="閉じる" Click="CloseButton_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CountText" Text="確認中" Foreground="#AFC7E8" Margin="4,2,4,10" />
                    <ListBox x:Name="ProposalList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ProposalList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,8" Background="#1B2430" BorderBrush="#344252"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SkillName}" FontWeight="SemiBold" Foreground="#F5F7FA"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                   FontSize="11" Margin="8,1,0,0" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}"
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   FontSize="12" Margin="0,5,0,0" MaxHeight="38" />
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                                   Text="{Binding UpdatedAt, StringFormat=更新 {0:yyyy-MM-dd HH:mm}}"
                                                   Foreground="#687482" FontSize="10" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailTitle" Text="候補を選択してください" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailStatus" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="DetailText" Grid.Row="2" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="DiffText" Grid.Row="4" IsReadOnly="True" Text=""
                             Background="#0F141B" Foreground="#DDE7F3" BorderBrush="#344252" BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas, Yu Gothic UI" FontSize="12" Padding="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Text="準備中" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ApproveButton" Content="承認" Click="ApproveButton_Click" IsEnabled="False" />
                <Button x:Name="RejectButton" Content="却下" Click="RejectButton_Click" IsEnabled="False" />
                <Button x:Name="ApplyButton" Content="適用" Click="ApplyButton_Click" IsEnabled="False"
                        Background="#245446" BorderBrush="#3B806D" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
