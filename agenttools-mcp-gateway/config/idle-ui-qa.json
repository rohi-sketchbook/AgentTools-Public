{
  "enabled": false,
  "projectRoot": "${AGENTTOOLS_ROOT}",
  "idleMinutes": 30,
  "checkIntervalMinutes": 10,
  "maxImages": 12,
  "maxKnownIssuesInPrompt": 100,
  "worker": {
    "provider": "codex",
    "role": "idleQa",
    "usageThresholdPercent": 90
  },
  "screenshotDirectories": [
    "UserData/Screenshots",
    "Logs/Screenshots",
    "TestResults/Screenshots"
  ],
  "stateFile": "state/idle-ui-qa/state.json",
  "issuesFile": "state/idle-ui-qa/issues.json",
  "reportDirectory": "state/idle-ui-qa/reports"
}
